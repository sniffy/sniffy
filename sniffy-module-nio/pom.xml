<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>sniffy-parent</artifactId>
        <groupId>io.sniffy</groupId>
        <version>4.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>sniffy-module-nio</artifactId>

    <name>Sniffy NIO Module</name>
    <url>http://sniffy.io/</url>
    <description>Sniffy NIO Module</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonatypeOssDistMgmtSnapshotsUrl>https://oss.sonatype.org/content/repositories/snapshots/</sonatypeOssDistMgmtSnapshotsUrl>
        <nio.functional.runOrder>alphabetical</nio.functional.runOrder>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.sniffy</groupId>
            <artifactId>sniffy-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.sniffy</groupId>
            <artifactId>sniffy-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <configuration>
                    <ignores>
                        <!-- Signature-polymorphic invoke descriptors are call-site specific. -->
                        <ignore>java.lang.invoke.MethodHandle</ignore>
                        <ignore>sun.misc.Unsafe</ignore>
                        <ignore>sun.nio.ch.SelChImpl</ignore>
                        <ignore>sun.nio.ch.SelectionKeyImpl</ignore>
                    </ignores>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Merged into both inherited JUnit/TestNG executions; verified in help:effective-pom. -->
                    <forkedProcessTimeoutInSeconds>180</forkedProcessTimeoutInSeconds>
                    <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                </configuration>
                <executions>
                    <execution>
                        <id>JUnit-execution</id>
                        <configuration>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <runOrder>${nio.functional.runOrder}</runOrder>
                            <excludes>
                                <exclude>%regex[.*TestNg.*]</exclude>
                                <exclude>**/SniffySelectorProviderInstallationTest.java</exclude>
                            </excludes>
                            <excludedGroups>io.sniffy.nio.NioProviderLifecycleTest</excludedGroups>
                            <properties>
                                <property>
                                    <name>listener</name>
                                    <value>io.sniffy.nio.NioFunctionalTestRunListener</value>
                                </property>
                            </properties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>nio-provider-lifecycle-execution</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <testNGArtifactName>dev:null</testNGArtifactName>
                            <includes>
                                <include>**/SniffySelectorProviderInstallationTest.java</include>
                            </includes>
                            <groups>io.sniffy.nio.NioProviderLifecycleTest</groups>
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <reportsDirectory>${project.build.directory}/surefire-reports-provider-lifecycle</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <profile>
            <id>jdk9plus</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <jdk>[1.9,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDignore.symbol.file</arg>
                            </compilerArgs>
                            <source>1.8</source>
                            <target>1.8</target>
                            <testSource>1.8</testSource>
                            <testTarget>1.8</testTarget>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Surefire scans test classes before capability probes can open this package. -->
                            <argLine>--add-exports=java.base/sun.nio.ch=ALL-UNNAMED -Xmx1024m ${argLine}</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>
